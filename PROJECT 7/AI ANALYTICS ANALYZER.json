{
  "name": "AI ANALYTICS ANALYZER",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Create unique submission ID\nconst submissionId =\n  $json[\"Full Name\"] + \"_\" +\n  $json[\"Date Range From\"] + \"_\" +\n  $json[\"Date Range To\"];\n\n// Convert to hash\nconst submissionHash =\n  Buffer.from(submissionId).toString(\"base64\");\n\n// Workflow memory\nconst staticData =\n  $getWorkflowStaticData(\"global\");\n\n// Create storage object\nif (!staticData.processedHashes) {\n  staticData.processedHashes = {};\n}\n\n// Check duplicate\nif (staticData.processedHashes[submissionHash]) {\n  throw new Error(\"Duplicate submission detected\");\n}\n\n// Save current submission\nstaticData.processedHashes[submissionHash] =\n  Date.now();\n\n// Return proper object\nreturn [\n  {\n    json: {\n      ...$json,\n      submissionHash: submissionHash,\n      deduplicationPassed: true\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        352
      ],
      "id": "71d410e7-9f7f-4490-a414-00c2c513e781",
      "name": "DEDUPLICATION CHECK"
    },
    {
      "parameters": {
        "jsCode": "// INPUT SANITIZATION\n\nconst input = $json;\nconst errors = [];\n\n// REQUIRED FIELD VALIDATION\nconst requiredFields = [\n  \"Full Name\",\n  \"Email\",\n  \"Department\",\n  \"Date Range From\",\n  \"Date Range To\",\n  \"Data Source\",\n  \"Metrics\"\n];\n\n// CHECK MISSING FIELDS\nfor (const field of requiredFields) {\n\n  if (\n    !input[field] ||\n    String(input[field]).trim() === \"\"\n  ) {\n\n    errors.push(\n      `Missing required field: ${field}`\n    );\n  }\n}\n\n// EMAIL VALIDATION\nconst emailRegex =\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (\n  input[\"Email\"] &&\n  !emailRegex.test(input[\"Email\"])\n) {\n\n  errors.push(\"Invalid email format\");\n}\n\n// DATE VALIDATION\n\nconst fromDate =\n  new Date(input[\"Date Range From\"]);\n\nconst toDate =\n  new Date(input[\"Date Range To\"]);\n\nconst today =\n  new Date();\n\n// REMOVE TIME PART\ntoday.setHours(0,0,0,0);\nfromDate.setHours(0,0,0,0);\ntoDate.setHours(0,0,0,0);\n\n// INVALID DATE CHECK\nif (isNaN(fromDate.getTime())) {\n  errors.push(\"Invalid Date Range From\");\n}\n\nif (isNaN(toDate.getTime())) {\n  errors.push(\"Invalid Date Range To\");\n}\n\n// FUTURE DATE CHECK\nif (fromDate > today) {\n  errors.push(\n    \"Date Range From cannot be future date\"\n  );\n}\n\nif (toDate > today) {\n  errors.push(\n    \"Date Range To cannot be future date\"\n  );\n}\n\n// DATE ORDER CHECK\nif (fromDate > toDate) {\n  errors.push(\n    \"Date Range From must be before Date Range To\"\n  );\n}\n\n// MAX RANGE VALIDATION\nconst diffDays =\n  (toDate - fromDate) /\n  (1000 * 60 * 60 * 24);\n\nif (diffDays > 365) {\n  errors.push(\n    \"Date range cannot exceed 365 days\"\n  );\n}\n\n// SANITIZE TEXT\nconst sanitize = (str) => {\n\n  if (!str) return \"\";\n\n  return String(str)\n\n    // REMOVE HTML TAGS\n    .replace(/<[^>]*>/g, \"\")\n\n    // REMOVE JAVASCRIPT\n    .replace(/javascript:/gi, \"\")\n\n    // REMOVE EVENT HANDLERS\n    .replace(/on\\w+\\s*=/gi, \"\")\n\n    // TRIM SPACES\n    .trim()\n\n    // LIMIT LENGTH\n    .substring(0, 2000);\n};\n\n// IF ERRORS FOUND\nif (errors.length > 0) {\n\n  return {\n    json: {\n      ...input,\n      validationPassed: false,\n      validationErrors: errors\n    }\n  };\n}\n\n// RETURN CLEAN DATA\nreturn {\n  json: {\n\n    ...input,\n\n    \"Full Name\":\n      sanitize(input[\"Full Name\"]),\n\n    \"Metrics\":\n      sanitize(input[\"Metrics\"]),\n\n    \"Special AI Instructions\":\n      sanitize(\n        input[\"Special AI Instructions\"]\n      ),\n\n    validationPassed: true,\n\n    validationErrors: []\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        352
      ],
      "id": "f5e322b2-052a-48ba-b1d0-0cfbeeff3bd2",
      "name": "DATA VALIDATOR"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "af23b9a1-9063-4f50-94e9-0a6e7b61ac92",
              "leftValue": "={{ $json.validationPassed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        624
      ],
      "id": "5cd407f3-27c3-4bee-a44d-e50306314237",
      "name": "INPUT VALIDATOR"
    },
    {
      "parameters": {
        "jsCode": "// DATA CHOOSER\n\nconst source =\n  $json[\"Data Source\"];\n\nconst dateFrom =\n  $json[\"Date Range From\"];\n\nconst dateTo =\n  $json[\"Date Range To\"];\n\nconst metrics =\n  $json[\"Metrics\"]\n    .split(\",\")\n    .map(m => m.trim());\n\nconst department =\n  $json[\"Department\"];\n\n// Build structured configuration\nreturn {\n  json: {\n\n    ...$json,\n\n    queryConfig: {\n\n      source: source,\n\n      dateFrom: dateFrom,\n\n      dateTo: dateTo,\n\n      metrics: metrics,\n\n      department: department,\n\n      reportType:\n        $json[\"Report Type\"] ||\n        \"Full analysis + forecast\",\n\n      outputFormat:\n        $json[\"Output Format\"] ||\n        \"Email HTML\",\n\n      aiInstructions:\n        $json[\"Special AI Instructions\"] || \"\",\n\n      requesterEmail:\n        $json[\"Email\"],\n\n      requesterName:\n        $json[\"Full Name\"],\n\n      additionalRecipients:\n        ($json[\"Additional Recipients\"] || \"\")\n          .split(\",\")\n          .map(e => e.trim())\n          .filter(Boolean)\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        432
      ],
      "id": "58feb16f-eadc-474d-aca9-79917512a688",
      "name": "DATA CHOOSER"
    },
    {
      "parameters": {
        "jsCode": "// GET EXISTING CONFIG\n\nconst config = $json.queryConfig;\n\n// STANDARDIZE METRICS\n\nconst normalizedMetrics =\n  config.metrics.map(metric => {\n\n    const clean =\n      metric.toLowerCase().trim();\n\n    // Metric normalization map\n    const metricMap = {\n\n      \"cac\":\n        \"customer acquisition cost\",\n\n      \"ltv\":\n        \"lifetime value\",\n\n      \"rev\":\n        \"revenue\",\n\n      \"churn\":\n        \"customer churn\",\n\n      \"roi\":\n        \"return on investment\"\n    };\n\n    return metricMap[clean] || clean;\n  });\n\n// STANDARDIZE DEPARTMENT\n\nconst normalizedDepartment =\n  config.department\n    .toLowerCase()\n    .trim();\n\n// CREATE DATE OBJECTS\n\nconst startDate =\n  new Date(config.dateFrom);\n\nconst endDate =\n  new Date(config.dateTo);\n\n// CALCULATE RANGE DAYS\n\nconst timeDifference =\n  endDate - startDate;\n\nconst totalDays =\n  Math.ceil(\n    timeDifference / (1000 * 60 * 60 * 24)\n  );\n\n// CREATE NORMALIZED QUERY\n\nconst normalizedQuery = {\n\n  ...config,\n\n  normalizedMetrics,\n\n  normalizedDepartment,\n\n  analyticsWindowDays:\n    totalDays,\n\n  generatedAt:\n    new Date().toISOString(),\n\n  aiReadyPrompt:\n    `\n    Analyze ${normalizedDepartment}\n    department performance using\n    metrics:\n    ${normalizedMetrics.join(\", \")}\n\n    Time period:\n    ${config.dateFrom}\n    to\n    ${config.dateTo}\n    `\n};\n\n// RETURN FINAL OBJECT\n\nreturn {\n  json: {\n\n    ...$json,\n\n    normalizedQuery\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        432
      ],
      "id": "d557dadc-c386-4d73-8477-e9d1df5fffce",
      "name": "ADVANCED QUERY NORMALIZER"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior business intelligence analyst.\n\nAnalyze the business context and generate\nan executive-level narrative summary.\n\nDepartment:\n{{ $json.normalizedQuery.normalizedDepartment }}\n\nMetrics:\n{{ $json.normalizedQuery.normalizedMetrics.join(\", \") }}\n\nAnalysis Window:\n{{ $json.normalizedQuery.analyticsWindowDays }} days\n\nBusiness Context:\n{{ $json.normalizedQuery.aiReadyPrompt }}\n\nFocus on:\n- operational performance\n- business direction\n- strategic interpretation\n- executive readability",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
