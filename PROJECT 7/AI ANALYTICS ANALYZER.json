    {
      "parameters": {
        "jsCode": "let html = $json.text || \"\";\n\n// REMOVE ```html\nhtml = html.replace(/```html/gi, \"\");\n\n// REMOVE ```\nhtml = html.replace(/```/g, \"\");\n\n// CONVERT ESCAPED NEWLINES\nhtml = html.replace(/\\\\n/g, \"\\n\");\n\n// OPTIONAL: REMOVE ESCAPED TABS\nhtml = html.replace(/\\\\t/g, \"\\t\");\n\n// TRIM EXTRA SPACES\nhtml = html.trim();\n\nreturn {\n  json: {\n    ...$json,\n    text: html\n  }\n};"
      },
